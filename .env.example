# Google AdSense — ENABLED=true 이고 CLIENT_ID가 있어야 광고가 렌더링됩니다.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_TOP_SLOT=
NEXT_PUBLIC_ADSENSE_BOTTOM_SLOT=

# 네이버 브랜드커넥트 — 배너 내용은 src/config/brandConnect.ts 에서 수정합니다.
# 비워 두면 brandConnect.ts 의 enabled 값을 따릅니다.
NEXT_PUBLIC_BRAND_CONNECT_ENABLED=true

# SEO — 실제 배포 도메인 (canonical, sitemap.xml, robots.txt, OG 이미지 주소에 쓰임)
NEXT_PUBLIC_SITE_URL=https://rowflip.com
# 구글 서치 콘솔 / 네이버 서치어드바이저 HTML 태그 인증값 (content="..." 안의 값만)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# 카카오톡 공유 — 카카오 디벨로퍼스 앱의 JavaScript 키. 비워 두면 카카오톡 버튼이 숨겨집니다.
# (앱 설정 > 플랫폼 > Web 사이트 도메인, 제품 링크 관리 > 웹 도메인에 배포 도메인 등록 필요)
NEXT_PUBLIC_KAKAO_JS_KEY=
# 선택: 카카오 SDK 다운로드 페이지의 SRI 해시
NEXT_PUBLIC_KAKAO_SDK_INTEGRITY=

# 개인정보처리방침의 문의 메일 (페이지에 공개됩니다). 비워 두면 기본값 contact@rowflip.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 측정 ID. 비우면 기본값(src/config/analytics.ts), off 로 두면 GA를 넣지 않습니다.
NEXT_PUBLIC_GA_ID=
